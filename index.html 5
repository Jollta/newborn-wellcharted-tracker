<!--
============================================================
  PATIENT 101 RESOURCE LIBRARY  —  WellCharted Health
============================================================
  HOW THIS PAGE WORKS
  - This is your single "source of truth" for the cheat sheets.
  - Only lessons that are LIVE on YouTube should be unlocked here.
  - Everyone who has the link sees exactly what is currently published,
    so nobody is ever out of sync — new subscribers and binge-watchers alike.

  TO UNLOCK A LESSON EACH WEEK (do this the day you publish on YouTube):
  1. Find the lesson card below (they are numbered LESSON 01 ... LESSON 10).
  2. Change  class="card locked"  to  class="card"      (removes the grey/lock)
  3. Change the button block from the LOCKED version to the ACTIVE version.
     Each locked card has the ACTIVE version commented out just above the
     lock tag — swap which one is commented.
  4. Put your real PDF filename in the href (e.g. cheatsheets/lesson-03.pdf).
  Save, upload to your repo, done. (Cache-bust with ?v=2 if it looks stale.)

  LESSON ORDER = your Table of Contents (confirmed canonical). Renumber the
  individual PDFs to match these numbers before linking them.

  REPLACE BEFORE LAUNCH:
  - The SVG leaf logo below with your real base64 logo, if you prefer.
  - PDF filenames in each href (organizer, table-of-contents, lesson-01..10).
  - The unlisted URL you host this at (something hard to guess).
  - Your real YouTube channel link in the footer.
============================================================
-->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600;700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">

<style>
  :root{
    --navy:#2d4a8a;
    --navy-deep:#243d73;
    --gold:#c9a84c;
    --gold-soft:#e4d29a;
    --cream:#f5f3ec;
    --ink:#2b2b28;
    --muted:#6b6b63;
    --line:#e3ded1;
    --card:#ffffff;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--cream);
    color:var(--ink);
    font-family:"DM Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  a{color:var(--navy);}
  .wrap{max-width:1000px;margin:0 auto;padding:0 22px;}

  /* ---------- Header ---------- */
  header.site{
    background:var(--navy);
    color:#fff;
    padding:38px 0 42px;
    text-align:center;
  }
  .brand-lockup{display:flex;flex-direction:column;align-items:center;gap:12px;margin-bottom:22px;}
  .logo-mark{width:76px;height:auto;flex:none;display:block;}
  .logo-word{
    font-family:"Lora",Georgia,serif;
    font-weight:700;
    font-size:1.65rem;
    letter-spacing:.3px;
    color:#fff;
  }
  .logo-word .accent{color:var(--gold-soft);}
  header.site h1{
    font-family:"Lora",Georgia,serif;
    font-weight:700;
    font-size:2.15rem;
    margin:.1em 0 .25em;
    line-height:1.15;
  }
  header.site p.tag{
    margin:0 auto;
    max-width:560px;
    color:#dfe4f1;
    font-size:1.02rem;
  }
  .credential{
    display:inline-block;
    margin-top:16px;
    font-size:.78rem;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--gold-soft);
    border:1px solid rgba(228,210,154,.5);
    border-radius:999px;
    padding:5px 14px;
  }

  /* ---------- Intro / how to use ---------- */
  .intro{
    background:#fff;
    border-bottom:1px solid var(--line);
    padding:26px 0;
  }
  .intro .wrap{max-width:760px;text-align:center;}
  .intro p{margin:0;color:var(--muted);font-size:1rem;}

  /* ---------- Start here featured card ---------- */
  section{padding:38px 0;}
  .eyebrow{
    font-size:.76rem;letter-spacing:.16em;text-transform:uppercase;
    color:var(--gold);font-weight:700;margin:0 0 14px;
  }
  .starter{
    background:linear-gradient(135deg,var(--navy) 0%,var(--navy-deep) 100%);
    color:#fff;border-radius:16px;padding:30px 30px 32px;
    display:flex;flex-wrap:wrap;align-items:center;gap:24px;justify-content:space-between;
    box-shadow:0 10px 30px rgba(45,74,138,.18);
  }
  .starter .txt{flex:1 1 320px;}
  .starter h2{
    font-family:"Lora",Georgia,serif;font-weight:700;font-size:1.5rem;margin:0 0 8px;
  }
  .starter p{margin:0;color:#dfe4f1;font-size:.98rem;max-width:460px;}
  .starter p.also{margin-top:12px;font-size:.9rem;color:var(--gold-soft);}
  .starter-btns{display:flex;flex-direction:column;gap:12px;flex:0 0 auto;}
  .btn{
    display:inline-block;text-decoration:none;font-weight:700;font-size:.98rem;
    padding:14px 26px;border-radius:10px;transition:transform .12s ease,box-shadow .12s ease;
    text-align:center;
  }
  .btn:hover{transform:translateY(-1px);}
  .btn-gold{background:var(--gold);color:#2b2410;box-shadow:0 6px 16px rgba(201,168,76,.35);}
  .btn-outline{background:transparent;color:#fff;border:1.5px solid rgba(228,210,154,.6);}
  .btn-outline:hover{background:rgba(255,255,255,.08);}
  .btn-block{white-space:nowrap;}

  /* ---------- Lesson grid ---------- */
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;}
  .card{
    background:var(--card);border:1px solid var(--line);border-radius:14px;
    padding:22px 22px 24px;display:flex;flex-direction:column;
    transition:box-shadow .15s ease,transform .15s ease;
  }
  .card:not(.locked):hover{box-shadow:0 8px 22px rgba(43,43,40,.08);transform:translateY(-2px);}
  .num{
    display:inline-flex;align-items:center;justify-content:center;
    width:40px;height:40px;border-radius:10px;
    background:var(--cream);color:var(--navy);
    font-family:"Lora",serif;font-weight:700;font-size:1.05rem;margin-bottom:14px;
  }
  .card h3{
    font-family:"Lora",Georgia,serif;font-weight:600;font-size:1.16rem;
    margin:0 0 8px;line-height:1.25;color:var(--ink);
  }
  .card p.desc{margin:0 0 20px;color:var(--muted);font-size:.94rem;flex:1;}
  .card .action{margin-top:auto;}
  .btn-sm{
    display:inline-block;text-decoration:none;font-weight:700;font-size:.9rem;
    padding:11px 18px;border-radius:9px;background:var(--gold);color:#2b2410;
  }
  .btn-sm:hover{background:#bb9a3f;}

  /* locked state */
  .card.locked{background:#f7f5ee;border-style:dashed;opacity:.85;}
  .card.locked .num{background:#ece7d8;color:#a9a493;}
  .card.locked h3{color:#8f8b7e;}
  .locked-tag{
    display:inline-flex;align-items:center;gap:7px;
    font-size:.86rem;font-weight:600;color:#a09a88;
  }
  .locked-tag svg{width:15px;height:15px;}

  /* ---------- Footer ---------- */
  footer.site{background:var(--navy);color:#cdd5e8;padding:34px 0 40px;margin-top:20px;}
  footer.site .wrap{max-width:760px;text-align:center;}
  .disclaimer{
    font-size:.82rem;color:#aeb8d2;background:rgba(255,255,255,.06);
    border:1px solid rgba(255,255,255,.12);border-radius:10px;
    padding:16px 20px;margin:0 0 22px;line-height:1.55;
  }
  footer.site a{color:var(--gold-soft);text-decoration:none;font-weight:600;}
  footer.site a:hover{text-decoration:underline;}
  .foot-links{font-size:.95rem;margin-bottom:14px;}
  .foot-links a{margin:0 10px;}
  .copyright{font-size:.8rem;color:#8b95b3;}

  @media (max-width:560px){
    header.site h1{font-size:1.7rem;}
    .starter{padding:24px 22px;}
    .starter-btns{width:100%;}
    section{padding:30px 0;}
  }
</style>
</head>
